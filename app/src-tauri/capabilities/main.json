{
  "identifier": "main",
  "description": "The main window may read the app name and version and call the app's own project commands (read-only, plus the folder dialog and recent-projects list), and nothing else.",
  "windows": ["main"],
  "permissions": [
    "core:app:allow-name",
    "core:app:allow-version",
    "allow-project-status",
    "allow-wait-for-project",
    "allow-tree-children",
    "allow-element-detail",
    "allow-element-links",
    "allow-element-impact",
    "allow-coverage-gaps",
    "allow-source-lines",
    "allow-problems",
    "allow-search",
    "allow-pick-folder",
    "allow-open-project",
    "allow-recent-projects",
    "allow-clear-recent"
  ]
}
