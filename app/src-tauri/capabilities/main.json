{
  "identifier": "main",
  "description": "The main window may read the app name and version, hear its own close request and then close itself, so edits are saved first, and call the app's own project commands (read-only, plus the folder dialog, the recent-projects list, and saving an existing .sysml file in the open project), and nothing else.",
  "windows": ["main"],
  "permissions": [
    "core:app:allow-name",
    "core:app:allow-version",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-destroy",
    "allow-project-status",
    "allow-wait-for-project",
    "allow-wait-for-disk-change",
    "allow-tree-children",
    "allow-element-detail",
    "allow-element-links",
    "allow-element-impact",
    "allow-coverage-gaps",
    "allow-source-lines",
    "allow-source-text",
    "allow-save-source",
    "allow-validate-source",
    "allow-revert-source",
    "allow-editor-keywords",
    "allow-problems",
    "allow-search",
    "allow-pick-folder",
    "allow-open-project",
    "allow-recent-projects",
    "allow-clear-recent"
  ]
}
